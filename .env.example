APP_NAME=Quran International
NODE_ENV=development
PORT=5000
IP_ADDRESS=127.0.0.1
DATABASE_URL=mongodb://localhost:27017/quran-international
CLIENT_URL=http://localhost:3000
clientUrl=http://localhost:3000

BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SERVER_UPLOAD_MAX_VIDEO_SIZE_MB=10
ENABLE_SUBSCRIPTION_MONITORING=false
DAILY_REPORT_TIME=09:00

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRE_IN=1h
SESSION_SECRET=your-session-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=180d
JWT_REFRESH_EXPIRE_LONG=365d
TEMP_JWT_SECRET=your-temp-jwt-secret
TEMP_JWT_EXPIRE_IN=1h

# Email (SMTP)
EMAIL_FROM=your-email@example.com
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_PORT=587
EMAIL_HOST=smtp.example.com

# Google OAuth (web callback + mobile idToken audience)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Mobile social login body: { "provider": "google"|"apple", "idToken": "...", "deviceToken": "..." }
APPLE_CLIENT_ID=your-apple-client-id

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=your-aws-region
AWS_BUCKET_NAME=your-aws-bucket-name

# Firebase push (base64 service account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=your-firebase-service-account-base64

# Maps
SERVER_MAP_API_KEY=your-server-map-api-key

# Super Admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your-super-admin-password

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_PAYMENT_WEBHOOK_SECRET=your-stripe-payment-webhook-secret
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=your-stripe-subscription-webhook-secret

# Apple / Google IAP
APPLE_SHARED_SECRET=your-apple-shared-secret
GOOGLE_PLAY_PACKAGE_NAME=your.package.name
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=your-service-account@example.com
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
